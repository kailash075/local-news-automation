{
  "name": "erodeglitz",
  "version": "0.1.0",
  "private": true,
  "description": "Tamil-first local news pipeline for the ErodeGlitz Instagram page (Erode city and district)",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "job:collect": "node src/jobs/collect.ts",
    "job:draft": "node src/jobs/draft.ts",
    "job:publish": "node src/jobs/publish.ts",
    "job:review-command": "node src/jobs/review-command.ts",
    "job:collect-switch": "node src/jobs/collect-switch.ts",
    "job:status": "node src/jobs/status.ts",
    "job:token-refresh": "node src/jobs/token-refresh.ts",
    "job:migrate": "node src/jobs/migrate.ts",
    "render:samples": "node src/jobs/render-samples.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
