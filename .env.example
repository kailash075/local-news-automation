# Copy to .env for local experiments. .env is git-ignored. Placeholders only; never commit real values.
# Nothing posts without a file named LIVE in the repository root (Coimbatore 360's go-live switch).

DRY_RUN=true                # must be exactly "false" to publish
PAUSED=                     # "true" stops all posting

SHEET_BRIDGE_URL=           # Apps Script web app URL, https://script.google.com/macros/s/<id>/exec
SHEET_BRIDGE_KEY=           # Script property BRIDGE_KEY (created by initBridge)
CLOUDINARY_CLOUD_NAME=      # Cloudinary dashboard: cloud name
CLOUDINARY_API_KEY=         # Cloudinary dashboard: API key
CLOUDINARY_API_SECRET=      # Cloudinary dashboard: API secret
CLOUDINARY_FOLDER=erodeglitz
TOKEN_ENCRYPTION_KEY=       # openssl rand -base64 32

EDITOR_GITHUB_LOGINS=kailash075
OWNER_GITHUB_LOGIN=kailash075
POSTING_WINDOW_IST=08:00-21:00
MAX_POSTS_PER_DAY=6
MIN_MINUTES_BETWEEN_POSTS=30
APPROVAL_TTL_HOURS=12
MAX_STORY_AGE_HOURS=36
IG_GRAPH_VERSION=v26.0
IG_USERNAME=erodeglitz
